# Neon Postgres. Pooled URL for the app; unpooled (direct) URL for Prisma migrations.
# Local Docker alternative: postgresql://frontpage:frontpage@localhost:5433/frontpage (same value for both)
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
# Auth.js secret: openssl rand -base64 32
AUTH_SECRET=""
# Vercel Cron bearer secret for /api/cron/refresh: openssl rand -hex 24
CRON_SECRET=""
